# Copy this file to .env (which is git-ignored).
# Process environment variables win over this file; CLI flags win over both.

# Gateway web application
SUNO_GATEWAY_LISTEN=127.0.0.1:8080
SUNO_GATEWAY_DATA_DIR=data/gateway
# suno = only /api/*, openai = only /v1/*, both = both families
SUNO_GATEWAY_API_STYLE=both
# Optional: SUNO_GATEWAY_ADMIN_KEY_FILE=admin.key
# Optional: SUNO_ADMIN_KEY=<at least 32 characters without whitespace>

# Suno protocol and model
SUNO_PROTOCOL=web
SUNO_MODEL=v6-mini

# Optional network settings
# SUNO_PROXY=http://127.0.0.1:7890
SUNO_REQUEST_TIMEOUT=10m

# Optional single-account commands (generate / download / session)
# SUNO_TOKEN_FILE=session.token
# SUNO_AUTH_COOKIE_FILE=auth.cookie
# SUNO_AUTO_REFRESH=true
# SUNO_REFRESH_BEFORE=60s
